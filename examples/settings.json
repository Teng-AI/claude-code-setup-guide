{
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); if echo \"$cmd\" | grep -qE '(^|[ ;&|(])git .*push.*( -[a-zA-Z]*f[a-zA-Z]*($| )| --force| [+][^ ])'; then echo 'Blocked: force-push from the agent is not allowed. Do it yourself if you really mean it.' >&2; exit 2; fi; if echo \"$cmd\" | grep -qE '(^|[ ;&|(])git .*push.*( |:|/|[+])(main|master)($| )'; then authors=$(git log --format='%ae' 2>/dev/null | grep -Fvx 'noreply@anthropic.com' | sort -u | wc -l | tr -d ' '); if [ \"${authors:-0}\" -gt 1 ]; then echo 'Blocked: this repo has multiple contributors - do not push directly to main/master. Use a feature branch + PR.' >&2; exit 2; fi; fi; exit 0"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/repo-visibility-guard.py",
            "timeout": 20,
            "statusMessage": "Checking repo visibility change",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/mini-memory-guard.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/humanizer-check.sh",
            "timeout": 10,
            "statusMessage": "Checking for AI-writing tells"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/harness-lint-check.sh",
            "timeout": 20,
            "statusMessage": "Checking harness references"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/audit-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/session-pull.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "visual-explainer-marketplace": {
      "source": {
        "source": "github",
        "repo": "nicobailon/visual-explainer"
      }
    },
    "claude-mermaid": {
      "source": {
        "source": "github",
        "repo": "veelenga/claude-mermaid"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "effortLevel": "xhigh"
}
